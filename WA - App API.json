    {
      "parameters": {
        "jsCode": "// One output item per contact, with the full WhatsApp API payload ready to send.\nconst b = $input.first().json.body || {};\nconst contacts = Array.isArray(b.contacts) ? b.contacts : [];\nif (!b.campaignId || !b.templateName || !b.language) {\n  throw new Error('campaignId, templateName and language are required');\n}\nreturn contacts.map(c => {\n  const params = Array.isArray(c.params) ? c.params : [];\n  const template = { name: b.templateName, language: { code: b.language } };\n  if (params.length) {\n    template.components = [{\n      type: 'body',\n      parameters: params.map(p => ({ type: 'text', text: String(p) }))\n    }];\n  }\n  return { json: {\n    campaignId: b.campaignId,\n    phone: String(c.phone),\n    payload: {\n      messaging_product: 'whatsapp',\n      recipient_type: 'individual',\n      to: String(c.phone),\n      type: 'template',\n      biz_opaque_callback_data: b.campaignId,   // comes back in every status webhook\n      template\n    }\n  }};\n});"
      },
