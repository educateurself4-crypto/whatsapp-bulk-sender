    {
      "parameters": {
        "jsCode": "const cid = $('Webhook Status').first().json.body.campaignId;\nconst msgs = $('Get Messages').all().map(i => i.json).filter(r => r.campaign_id === cid && r.phone);\nconst evs  = $('Get Events').all().map(i => i.json).filter(r => r.campaign_id === cid && r.wa_message_id);\n\nconst accepted   = msgs.filter(m => m.send_status === 'accepted');\nconst sendFailed = msgs.filter(m => m.send_status === 'failed');\n\nconst st = {};   // wa_message_id -> flags\nfor (const e of evs) {\n  const s = st[e.wa_message_id] || (st[e.wa_message_id] = {});\n  if (e.status === 'read') { s.read = true; s.delivered = true; }\n  else if (e.status === 'delivered') { s.delivered = true; }\n  else if (e.status === 'failed') { s.failed = true; s.reason = `${e.error_code} ${e.error_text}`.trim(); }\n}\n\nlet delivered = 0, read = 0, deliveryFailed = 0;\nconst failures = sendFailed.map(m => ({ phone: m.phone, stage: 'send', reason: m.error }));\nfor (const m of accepted) {\n  const s = st[m.wa_message_id] || {};\n  if (s.read) read++;\n  if (s.delivered) delivered++;\n  else if (s.failed) { deliveryFailed++; failures.push({ phone: m.phone, stage: 'delivery', reason: s.reason }); }\n}\nreturn [{ json: {\n  processed: msgs.length, accepted: accepted.length, send_failed: sendFailed.length,\n  delivered, read, delivery_failed: deliveryFailed, failures\n}}];"
      },
