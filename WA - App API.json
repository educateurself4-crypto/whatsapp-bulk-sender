    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Turn the WhatsApp API response (success OR error body) into one row for the Messages sheet.\nconst src = $('Prepare Messages').item.json;\nconst r = $json || {};\nconst id = r.messages && r.messages[0] && r.messages[0].id;\nconst e = r.error || null;\nlet err = '';\nif (!id) {\n  if (e && typeof e === 'object') {\n    const details = (e.error_data && e.error_data.details) || e.message || '';\n    err = `${e.code || ''} ${details}`.trim();\n  } else {\n    err = e ? String(e) : 'unknown error (no message id returned)';\n  }\n}\nreturn { json: {\n  campaign_id: src.campaignId,\n  phone: src.phone,\n  wa_message_id: id || '',\n  send_status: id ? 'accepted' : 'failed',\n  error: err,\n  sent_at: new Date().toISOString()\n}};"
      },
