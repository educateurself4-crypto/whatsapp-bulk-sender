    {
      "parameters": {
        "jsCode": "// Meta posts statuses (sent/delivered/read/failed) and inbound messages here.\n// We keep delivered/read/failed (fewer sheet writes) and detect STOP-style opt-outs.\nconst body = $input.first().json.body || {};\nconst out = [];\nconst iso = ts => new Date(Number(ts) * 1000).toISOString();\nfor (const entry of (body.entry || [])) {\n  for (const ch of (entry.changes || [])) {\n    const v = ch.value || {};\n    for (const s of (v.statuses || [])) {\n      if (!['delivered', 'read', 'failed'].includes(s.status)) continue;\n      const err = (s.errors && s.errors[0]) || {};\n      out.push({ json: {\n        campaign_id: s.biz_opaque_callback_data || '',\n        wa_message_id: s.id,\n        phone: s.recipient_id,\n        status: s.status,\n        error_code: err.code || '',\n        error_text: (err.error_data && err.error_data.details) || err.message || err.title || '',\n        timestamp: iso(s.timestamp)\n      }});\n    }\n    for (const m of (v.messages || [])) {\n      const txt = ((m.text && m.text.body) || (m.button && (m.button.text || m.button.payload)) ||\n                   (m.interactive && m.interactive.button_reply && m.interactive.button_reply.title) || '')\n                  .trim().toUpperCase();\n      if (['STOP', 'UNSUBSCRIBE', 'STOP PROMOTIONS', 'OPT OUT', 'OPTOUT'].includes(txt)) {\n        out.push({ json: {\n          campaign_id: '', wa_message_id: m.id, phone: m.from, status: 'optout',\n          error_code: '', error_text: '', timestamp: iso(m.timestamp)\n        }});\n      }\n    }\n  }\n}\nreturn out;"
      },
